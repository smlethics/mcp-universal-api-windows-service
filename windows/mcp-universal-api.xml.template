<service>
  <id>mcp-universal-api</id>
  <name>MCP Universal API Server</name>
  <description>Spring AI MCP server exposing configured external APIs as MCP tools.</description>
  <executable>%JAVA_EXE%</executable>
  <arguments>-jar "%APP_HOME%\mcp-universal-api-windows-service.jar" --spring.config.additional-location=file:"%APP_HOME%\application.yml</arguments>
  <workingdirectory>%APP_HOME%</workingdirectory>
  <logpath>%APP_HOME%\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>8</keepFiles></log>
  <onfailure action="restart" delay="10 sec"/>
  <startmode>Automatic</startmode>
</service>
